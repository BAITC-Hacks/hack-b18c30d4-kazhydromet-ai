OPENAI_API_KEY=
# Проверь на месте, какие модели покрывают выданные кредиты
OPENAI_MODEL=gpt-5-mini

# NVIDIA (необязательно): ключ nvapi-... с build.nvidia.com. Включить: LLM_PROVIDER=nvidia
# При отсутствии ключа выбранного провайдера или ошибке настройки работает локальный demo/mock.
# Автоматического переключения с NVIDIA на OpenAI нет. После изменений перезапустите сервер.
LLM_PROVIDER=openai
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Для общего облачного сервера: запрет изменения данных и ограничения платного чата.
PUBLIC_DEMO=0
