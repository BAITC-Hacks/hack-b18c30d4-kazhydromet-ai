#!/bin/sh
# Не даёт закоммитить .env и то, что похоже на API-ключ.
# Включается один раз: git config core.hooksPath .githooks

if git diff --cached --name-only | grep -qE '(^|/)\.env$'; then
  echo ""
  echo "  СТОП: в коммит попал файл .env с ключами."
  echo "  Убери его:  git restore --staged .env"
  echo ""
  exit 1
fi

if git diff --cached -U0 | grep -E '^\+' | grep -qE '(sk-[A-Za-z0-9_-]{20,}|OPENAI_API_KEY[[:space:]]*=[[:space:]]*[^[:space:]]+)'; then
  echo ""
  echo "  СТОП: в изменениях похоже на API-ключ."
  echo "  Ключи держим только в .env, в коде — os.getenv(\"OPENAI_API_KEY\")."
  echo "  Если это ложная тревога:  git commit --no-verify"
  echo ""
  exit 1
fi

exit 0
